# Copy this file to ".env" and fill in the values. Never commit ".env".

# Your Google Gemini API key (from https://aistudio.google.com/apikey).
# Stays on the server only. It is never sent to the extension.
GEMINI_API_KEY=

# Model ID. Check the current list at https://ai.google.dev/gemini-api/docs/models
# and change this if the model below is retired or you prefer another one.
GEMINI_MODEL=gemini-3.8-flash

# A long random string that the extension sends in the "x-extension-token" header.
# Without it, anyone who finds your server URL could spend your Gemini quota.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EXTENSION_TOKEN=30628b4e59567e8681bb60534987aa4848d8447ab95722ef5b61e20059381175

# Server settings. HOST=127.0.0.1 means "only this computer can connect".
PORT=3000
HOST=127.0.0.1

# Max generate requests per IP per minute (protects your limited Gemini quota).
RATE_LIMIT_PER_MIN=20
